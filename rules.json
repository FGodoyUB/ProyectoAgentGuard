{
  "rules": [
    {
      "id": "PI-001",
      "name": "Ignore previous instructions",
      "scope": "input",
      "category": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)ignore\\s+(all\\s+)?previous\\s+instructions"
    },
    {
      "id": "PI-002",
      "name": "Reveal system prompt",
      "scope": "input",
      "category": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)(reveal|show|print|display)\\s+(the\\s+)?(system\\s+prompt|hidden\\s+instructions)"
    },
    {
      "id": "PI-003",
      "name": "Instruction override attempt",
      "scope": "input",
      "category": "prompt_injection",
      "severity": "medium",
      "pattern": "(?i)(you\\s+are\\s+now|act\\s+as|developer\\s+mode|jailbreak)"
    },
    {
      "id": "SEC-001",
      "name": "API key exposure",
      "scope": "output",
      "category": "credential_leak",
      "severity": "high",
      "pattern": "(?i)(api[_-]?key|secret[_-]?key|access[_-]?token)\\s*[:=]\\s*['\\\"]?[A-Za-z0-9_\\-]{16,}"
    },
    {
      "id": "SEC-002",
      "name": "Bearer token exposure",
      "scope": "output",
      "category": "credential_leak",
      "severity": "high",
      "pattern": "(?i)bearer\\s+[A-Za-z0-9_\\-\\.]{20,}"
    },
    {
      "id": "SEC-003",
      "name": "Password exposure",
      "scope": "output",
      "category": "credential_leak",
      "severity": "medium",
      "pattern": "(?i)(password|passwd|pwd)\\s*[:=]\\s*['\\\"]?[^\\s'\\\"]{6,}"
    },
    {
    "id": "prompt_injection_do_not_follow_user_request",
    "name": "External content tries to override user request",
    "scope": "input",
    "category": "prompt_injection",
    "severity": "high",
    "pattern": "do\\s+not\\s+follow\\s+the\\s+user'?s\\s+request"
    },
    {
    "id": "prompt_injection_correct_output_is",
    "name": "External content defines the expected output",
    "scope": "input",
    "category": "prompt_injection",
    "severity": "high",
    "pattern": "the\\s+correct\\s+output\\s+is"
    },
    {
    "id": "prompt_injection_write_only_sentence",
    "name": "External content instructs exact file output",
    "scope": "input",
    "category": "prompt_injection",
    "severity": "high",
    "pattern": "write\\s+only\\s+that\\s+sentence\\s+to\\s+the\\s+output\\s+file"
    }
  ]
}